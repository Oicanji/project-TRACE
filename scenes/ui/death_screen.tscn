theme_override_fonts/font = ExtResource("7_font_btn")
theme_override_font_sizes/font_size = 25
theme_override_styles/normal = SubResource("StyleBoxFlat_btn_normal")
theme_override_styles/pressed = SubResource("StyleBoxFlat_btn_pressed")
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/disabled = SubResource("StyleBoxFlat_btn_normal")
theme_override_styles/focus = SubResource("StyleBoxFlat_btn_focus")
text = "Menu Inicial"

[node name="QuitButton" type="Button" parent="Root/SafeMargin/MenuAnchor/MenuPanel/PanelPadding/ButtonList"]
custom_minimum_size = Vector2(264, 52)
layout_mode = 2
focus_neighbor_top = NodePath("../MainMenuButton")
focus_neighbor_bottom = NodePath("../RetryButton")
mouse_default_cursor_shape = 2
theme_override_colors/font_color = Color(0.99, 0.94, 0.92, 0.96)
theme_override_colors/font_focus_color = Color(1, 0.97, 0.95, 1)
theme_override_colors/font_pressed_color = Color(0.95, 0.84, 0.82, 1)
theme_override_colors/font_hover_color = Color(1, 0.97, 0.95, 1)
theme_override_fonts/font = ExtResource("7_font_btn")
theme_override_font_sizes/font_size = 25
theme_override_styles/normal = SubResource("StyleBoxFlat_btn_normal")
theme_override_styles/pressed = SubResource("StyleBoxFlat_btn_pressed")
theme_override_styles/hover = SubResource("StyleBoxFlat_btn_hover")
theme_override_styles/disabled = SubResource("StyleBoxFlat_btn_normal")
theme_override_styles/focus = SubResource("StyleBoxFlat_btn_focus")
text = "Sair"

[node name="OpenDelayTimer" type="Timer" parent="."]
wait_time = 0.45
one_shot = true

[node name="TransitionAnimPlayer" type="AnimationPlayer" parent="."]
libraries = {
&"": SubResource("AnimationLibrary_transition")
}

[node name="AmbientAnimPlayer" type="AnimationPlayer" parent="."]
libraries = {
&"": SubResource("AnimationLibrary_ambient")
}

[connection signal="timeout" from="OpenDelayTimer" to="." method="_on_open_delay_timer_timeout"]
[connection signal="pressed" from="Root/SafeMargin/MenuAnchor/MenuPanel/PanelPadding/ButtonList/RetryButton" to="." method="_on_retry_button_pressed"]
[connection signal="pressed" from="Root/SafeMargin/MenuAnchor/MenuPanel/PanelPadding/ButtonList/MainMenuButton" to="." method="_on_main_menu_button_pressed"]
[connection signal="pressed" from="Root/SafeMargin/MenuAnchor/MenuPanel/PanelPadding/ButtonList/QuitButton" to="." method="_on_quit_button_pressed"]
